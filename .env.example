# ReviveAI Environment Configuration

# Primary LLM Provider: 'gemini' or 'groq' (default: 'groq')
LLM_PROVIDER=groq

# Google Gemini API Key (Get from: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Groq API Key (Get from: https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: Diagnosis rate-limiting delay in seconds (default: 0.2)
DIAGNOSIS_DELAY_SECONDS=0.2

# --- Razorpay Test Mode Integration (Optional) ---
# Toggle live Razorpay link generation on or off: 'true' or 'false'
USE_REAL_RAZORPAY_LINKS=false

# Razorpay Test Mode API Keys (Get free from: https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
